[gd_scene format=3 uid="uid://cxdnp0kiblea2"]

[sub_resource type="GDScript" id="GDScript_tqyja"]
script/source = "extends CharacterBody2D

const speed = 400

func _ready() -> void:
	Binding.player = self

func _physics_process(_delta: float) -> void:
	var axis: Vector2
	axis.x = Input.get_axis(&\"Left\", &\"Right\")
	axis.y = Input.get_axis(&\"Up\", &\"Down\")
	if axis.x > 0.0:
		$AnimatedSprite2D.play(&\"left\")
	elif axis.x < 0.0:
		$AnimatedSprite2D.play(&\"left\")
	elif axis.y < 0.0:
		$AnimatedSprite2D.play(&\"up\")
	elif axis.y > 0.0:
		$AnimatedSprite2D.play(&\"down\")
	else:
		$AnimatedSprite2D.play(&\"idle\")
	axis = axis.normalized()
	velocity = axis*speed
	move_and_slide()
"

